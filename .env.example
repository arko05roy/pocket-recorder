GROQ_API_KEY=
PORT=8000
GROQ_MODEL=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=

# ESP32 print bridge. Leave PRINTER_HOST empty for a USB printer (firmware/usbprinter)
ESP32_URL=http://esp-printer.local
PRINTER_HOST=
PRINTER_PORT=9100
# For a Mac sharing a USB printer: PRINTER_HOST=<Mac IP>, PRINTER_PORT=631, PRINTER_QUEUE=<queue name from lpstat -p>
PRINTER_QUEUE=
WHISPER_MODEL=
WHISPER_LIVE_MODEL=
